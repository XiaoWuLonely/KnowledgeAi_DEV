# KnowFlow AI Docker Compose 环境变量模板。
# 复制为 .env 后再部署；生产部署前必须替换所有 CHANGE_ME 值。
# 不要把真实 API Key、OSS 密钥、JWT 密钥或模型加密密钥提交到 Git。

# 前端 Nginx 容器映射到宿主机的端口。
KNOWFLOW_FRONTEND_PORT=5173

# 后端 Spring Boot 容器映射到宿主机的端口。
KNOWFLOW_BACKEND_PORT=8080

# PostgreSQL 映射到宿主机的端口。本机已有 PostgreSQL 时可改为其他端口。
KNOWFLOW_POSTGRES_PORT=5432

# 后端服务使用的 PostgreSQL 数据库、用户和密码。
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# JWT 签名密钥。真实部署请使用至少 32 个随机字符。
KNOWFLOW_JWT_SECRET=CHANGE_ME_use_a_long_random_jwt_secret_at_least_32_chars

# 用户模型 API Key 的加密密钥。修改后，历史已保存的用户 API Key 将无法解密。
KNOWFLOW_MODEL_SECRET_KEY=CHANGE_ME_use_a_long_random_model_secret_at_least_32_chars

# 可选 OpenAI-compatible 兜底配置；仅当用户没有在 Settings 保存自己的模型配置时使用。
KNOWFLOW_AI_BASE_URL=
KNOWFLOW_AI_API_KEY=
KNOWFLOW_AI_MODEL=
# 可选 embedding 模型；留空时只使用全文检索，不写入语义向量。
KNOWFLOW_AI_EMBEDDING_MODEL=
KNOWFLOW_AI_TIMEOUT_SECONDS=60

# 可选阿里云 OSS 配置，用于用户头像上传。
# 留空时头像上传不可用，但默认头像仍可正常使用。
KNOWFLOW_OSS_ENDPOINT=
KNOWFLOW_OSS_BUCKET=
KNOWFLOW_OSS_ACCESS_KEY_ID=
KNOWFLOW_OSS_ACCESS_KEY_SECRET=
KNOWFLOW_OSS_AVATAR_PREFIX=knowflow/avatars

# 后端数据库连接池配置。默认值适合本地或演示环境。
KNOWFLOW_DB_MAX_POOL_SIZE=10
KNOWFLOW_DB_MIN_IDLE=1
